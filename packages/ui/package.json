{
  "name": "@buildwith/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/theme.css",
    "./tokens.css": "./src/tokens.css",
    "./assets/*": "./src/assets/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --experimental-strip-types scripts/contrast.ts",
    "contrast": "node --experimental-strip-types scripts/contrast.ts --all",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=19.2",
    "react-dom": ">=19.2"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "clsx": "2.1.1",
    "lucide-react": "1.82.0",
    "radix-ui": "1.8.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.9",
    "@storybook/react-vite": "10.6.9",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.9",
    "tailwindcss": "4.3.5",
    "vite": "8.4.0"
  }
}
