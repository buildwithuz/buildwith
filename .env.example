# Copy to .env for local development. Never commit .env.

# --- core ---
BUILDWITH_ENV=development
BUILDWITH_DATABASE_URL=postgres://buildwith:buildwith@localhost:5433/buildwith?sslmode=disable
BUILDWITH_TEST_DATABASE_URL=postgres://buildwith:buildwith@localhost:5433/buildwith_test?sslmode=disable
BUILDWITH_DB_PORT=5433

# api
BUILDWITH_API_ADDR=:8080
BUILDWITH_PUBLIC_ORIGIN=http://localhost:5173
BUILDWITH_MEDIA_DIR=./media
BUILDWITH_SESSION_SECRET=dev-only-change-me-0000000000000000

# web (React Router SSR)
PORT=5173
BUILDWITH_API_ORIGIN=http://localhost:8080

# --- optional: only needed to test these flows locally ---
# Dev login (username, no password) is enabled whenever BUILDWITH_ENV=development.
BUILDWITH_GITHUB_CLIENT_ID=
BUILDWITH_GITHUB_CLIENT_SECRET=
BUILDWITH_GOOGLE_CLIENT_ID=
BUILDWITH_GOOGLE_CLIENT_SECRET=
BUILDWITH_TELEGRAM_BOT_TOKEN=
BUILDWITH_TELEGRAM_BOT_USERNAME=
BUILDWITH_TELEGRAM_CHANNEL=

# Optional SMTP for company-email verification badges.
BUILDWITH_SMTP_ADDR=
BUILDWITH_SMTP_USER=
BUILDWITH_SMTP_PASSWORD=
BUILDWITH_SMTP_FROM=
