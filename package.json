{
  "name": "buildwith",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup:dev": "bash scripts/setup-dev.sh",
    "dev": "turbo run dev --parallel",
    "gen": "pnpm gen:go && pnpm gen:ts",
    "gen:go": "cd apps/api && go generate ./...",
    "gen:ts": "pnpm --filter @buildwith/api-client generate",
    "check": "pnpm check:ts && pnpm check:go",
    "check:ts": "biome ci . && turbo run typecheck test",
    "check:go": "bash scripts/check-go.sh",
    "build": "turbo run build",
    "biome": "biome",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke",
    "db:reset": "bash scripts/db-reset.sh",
    "db:up": "cd apps/api && go tool goose -dir db/migrations postgres \"$BUILDWITH_DATABASE_URL\" up",
    "db:down": "cd apps/api && go tool goose -dir db/migrations postgres \"$BUILDWITH_DATABASE_URL\" down",
    "db:seed": "cd apps/api && go run ./cmd/seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.11",
    "turbo": "2.11.13",
    "typescript": "5.9.3",
    "vitest": "5.1.2"
  }
}
