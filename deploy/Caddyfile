# buildwith.uz edge: TLS, security headers, /media from disk, /v1 to the API, the rest to web.
# BUILDWITH_DOMAIN and BUILDWITH_ACME_EMAIL come from compose.prod.yml.
{
	email {$BUILDWITH_ACME_EMAIL}
	servers {
		# SSE connections stay open; don't let idle timeouts cut them, but bound slow headers.
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
		-Server
		# Default policy, used unless the upstream sends its own ("?" = only if absent).
		# React Router's <Scripts>/<ScrollRestoration> emit per-request inline scripts, so script-src
		# needs 'unsafe-inline' until web sends a nonce-based policy itself (browsers ignore
		# 'unsafe-inline' once a nonce is present). Inline style *attributes* come from React/Radix.
		?Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://telegram.org; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://oauth.telegram.org; frame-ancestors 'none'; form-action 'self' https://github.com https://accounts.google.com https://oauth.telegram.org; base-uri 'self'; object-src 'none'; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests"
	}
}

www.{$BUILDWITH_DOMAIN} {
	import security_headers
	redir https://{$BUILDWITH_DOMAIN}{uri} permanent
}

{$BUILDWITH_DOMAIN} {
	import security_headers

	# A bit above the API's own 12 MiB cap so the API answers with its own error.
	request_body {
		max_size 13MiB
	}

	# Media names are content hashes, so they never change. Uploads are re-encoded images,
	# but sandbox them anyway in case a file is ever opened directly.
	handle_path /media/* {
		root * /srv/media
		header {
			Cache-Control "public, max-age=31536000, immutable"
			Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; sandbox"
			Cross-Origin-Resource-Policy "same-origin"
		}
		file_server
	}

	handle /v1/* {
		encode {
			zstd
			gzip
			# Never compress the event stream: compressors buffer and break SSE.
			match {
				header Content-Type application/json*
				header Content-Type application/rss+xml*
				header Content-Type application/atom+xml*
			}
		}
		reverse_proxy api:8080 {
			# Pass SSE (/v1/notifications/stream) through unbuffered.
			flush_interval -1
		}
	}

	handle {
		encode {
			zstd
			gzip
			match {
				header Content-Type text/html*
				header Content-Type text/css*
				header Content-Type text/plain*
				header Content-Type text/javascript*
				header Content-Type application/javascript*
				header Content-Type application/json*
				header Content-Type application/manifest+json*
				header Content-Type application/xml*
				header Content-Type application/rss+xml*
				header Content-Type application/atom+xml*
				header Content-Type image/svg+xml*
			}
		}
		# react-router-serve already marks hashed /assets/* immutable.
		reverse_proxy web:3000
	}

	log {
		output stdout
		format json
	}
}
