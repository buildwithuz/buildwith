# buildwith.uz on its own server: Caddy owns :80/:443 and gets certificates from Let's Encrypt.
# The routes are in site.caddy; Caddyfile.shared is the variant for running behind another proxy.
# BUILDWITH_DOMAIN comes from compose.prod.yml. No ACME email: Let's Encrypt doesn't
# need one, and buildwith.uz has no mailbox (support is the Telegram bot).
{
	servers {
		# SSE connections stay open; don't let idle timeouts cut them, but bound slow headers.
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

import site.caddy

www.{$BUILDWITH_DOMAIN} {
	import security_headers
	redir https://{$BUILDWITH_DOMAIN}{uri} permanent
}

{$BUILDWITH_DOMAIN} {
	import buildwith_site
}
