# Production settings. Copy to /srv/buildwith/.env.production (chmod 600, never committed).
# Generate secrets with: openssl rand -hex 32
# Values are read literally: no quotes, no spaces around "=".

# --- required ---
# Hex only: it is placed into the database URL as is.
POSTGRES_PASSWORD=
BUILDWITH_PUBLIC_ORIGIN=https://buildwith.uz

# --- edge (Caddy) ---
BUILDWITH_DOMAIN=buildwith.uz

# Where media lives on the host (uploads, served by Caddy). Default: /srv/buildwith/data
# BUILDWITH_DATA_DIR=/srv/buildwith/data

# BUILDWITH_SESSION_DAYS=30

# --- sign-in (each provider appears on /login only when configured) ---
# GitHub OAuth app: callback https://buildwith.uz/v1/auth/github/callback
BUILDWITH_GITHUB_CLIENT_ID=
BUILDWITH_GITHUB_CLIENT_SECRET=
# Google OAuth client: redirect URI https://buildwith.uz/v1/auth/google/callback
BUILDWITH_GOOGLE_CLIENT_ID=
BUILDWITH_GOOGLE_CLIENT_SECRET=

# --- Telegram (login widget, bot, channel autopost). Setting the token also starts the bot. ---
BUILDWITH_TELEGRAM_BOT_TOKEN=
BUILDWITH_TELEGRAM_BOT_USERNAME=
BUILDWITH_TELEGRAM_CHANNEL=
# The maintainers' support group (a negative id). Messages to the bot land here; replies go back.
BUILDWITH_TELEGRAM_SUPPORT_CHAT=

# --- SMTP (company-email verification badges) ---
BUILDWITH_SMTP_ADDR=
BUILDWITH_SMTP_USER=
BUILDWITH_SMTP_PASSWORD=
BUILDWITH_SMTP_FROM=

# --- backups (deploy/backup.sh) ---
# BUILDWITH_BACKUP_KEEP=14
# BUILDWITH_BACKUP_KEEP_LABELLED=5
# BUILDWITH_BACKUP_RSYNC_TARGET=backup@backup-host:/backups/buildwith/
# BUILDWITH_BACKUP_RSYNC_SSH=ssh -i /home/deploy/.ssh/backup_ed25519
